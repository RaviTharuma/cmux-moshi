#!/bin/sh
# Resolve and execute the cmux-moshi host CLI.
# Official plugin install runs `cargo build --release`, so prefer that binary.
# `bin/cmux-moshi-fetch` is a contributor helper only (not [build]).
set -eu

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  LINK=$(readlink "$SCRIPT") || exit 1
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$SCRIPT_DIR/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
RELEASE="$ROOT/target/release/cmux-moshi"
FETCHED="$ROOT/.cmux-moshi/bin/cmux-moshi"

if [ -x "$RELEASE" ]; then
  exec "$RELEASE" "$@"
fi
if [ ! -x "$FETCHED" ]; then
  "$ROOT/bin/cmux-moshi-fetch"
fi
[ -x "$FETCHED" ] || {
  printf 'cmux-moshi: runtime binary is missing after bootstrap: %s\n' "$FETCHED" >&2
  exit 1
}
exec "$FETCHED" "$@"
